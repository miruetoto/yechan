      "source": [
        "def build_path_laplacian(t, weight_fn):\n",
        "    \"\"\"가중 path graph의 라플라시안을 구성한다.\"\"\"\n",
        "    N = len(t)\n",
        "    W = np.zeros((N, N))\n",
        "    for i in range(N - 1):\n",
        "        d = t[i+1] - t[i]\n",
        "        w = weight_fn(d)\n",
        "        W[i, i+1] = w\n",
        "        W[i+1, i] = w\n",
        "    D = np.diag(W.sum(axis=1))\n",
        "    return D - W\n",
        "\n",
        "def denoise_all(y, L, x_clean):\n",
        "    \"\"\"주어진 라플라시안으로 7가지 방법을 적용하고 MSE를 반환한다.\"\"\"\n",
        "    N = len(y)\n",
        "    eigvals, V = np.linalg.eigh(L)\n",
        "    y_freq = V.T @ y\n",
        "\n",
        "    # Estimate sigma (MAD)\n",
        "    sigma_hat = np.median(np.abs(y_freq[N//2:])) / 0.6745\n",
        "\n",
        "    # Estimate PSD (spectral subtraction)\n",
        "    psd_hat = np.maximum(np.abs(y_freq)**2 - sigma_hat**2, 0)\n",
        "\n",
        "    results = {}\n",
        "    results['OLS'] = y.copy()\n",
        "    results['Ridge'] = V @ (1 / (1 + sigma_hat**2) * y_freq)\n",
        "    results['Lasso'] = V @ (np.sign(y_freq) * np.maximum(np.abs(y_freq) - sigma_hat, 0))\n",
        "    results['Hard Thr.'] = V @ (y_freq * (np.abs(y_freq) > sigma_hat))\n",
        "    results['Tikhonov'] = V @ (1 / (1 + sigma_hat**2 * eigvals) * y_freq)\n",
        "    c_js = max(0, 1 - (N - 2) * sigma_hat**2 / np.sum(y_freq**2))\n",
        "    results['James-Stein'] = V @ (c_js * y_freq)\n",
        "    H_w = psd_hat / (psd_hat + sigma_hat**2)\n",
        "    results['Wiener'] = V @ (H_w * y_freq)\n",
        "\n",
        "    mse = {name: np.mean((x_clean - x_hat)**2) for name, x_hat in results.items()}\n",
        "    return results, mse\n",
        "\n",
        "# 4 weight schemes\n",
        "weight_schemes = {\n",
        "    '1/d': lambda d: 1.0 / d,\n",
        "    '1/d²': lambda d: 1.0 / d**2,\n",
        "    'Gaussian': lambda d: np.exp(-d**2 / (2 * h_bw**2)),\n",
        "    'Unweighted': lambda d: 1.0,\n",
        "}\n",
        "\n",
        "all_results = {}\n",
        "all_mse = {}\n",
        "for wname, wfn in weight_schemes.items():\n",
        "    L3 = build_path_laplacian(t, wfn)\n",
        "    res, mse = denoise_all(y3, L3, x_clean3)\n",
        "    all_results[wname] = res\n",
        "    all_mse[wname] = mse\n",
        "\n",
        "# MSE comparison table\n",
        "methods = ['OLS', 'Ridge', 'Lasso', 'Hard Thr.', 'Tikhonov', 'James-Stein', 'Wiener']\n",
        "wnames = list(weight_schemes.keys())\n",
        "\n",
        "header = f'{\"Method\":12s}' + ''.join(f'{w:>12s}' for w in wnames)\n",
