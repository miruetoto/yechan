    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "N = 50\n",
        "G = nx.path_graph(N)\n",
        "A = nx.to_numpy_array(G)\n",
        "D = np.diag(A.sum(axis=1))\n",
        "L = D - A\n",
        "eigvals, V = eigh(L)\n",
