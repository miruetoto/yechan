      "source": [
        "# Adaptive graph: weight based on noisy signal similarity\n",
        "sigma_s = np.median(np.abs(np.diff(y7)))\n",
        "\n",
        "W7a = np.zeros((N7, N7))\n",
        "for i in range(N7 - 1):\n",
        "    w = np.exp(-(y7[i] - y7[i+1])**2 / (2 * sigma_s**2))\n",
        "    W7a[i, i+1] = w\n",
        "    W7a[i+1, i] = w\n",
        "\n",
        "D7a = np.diag(W7a.sum(axis=1))\n",
        "L7a = D7a - W7a\n",
        "\n",
        "# Visualize weights\n",
        "fig, axes = plt.subplots(1, 2)\n",
        "\n",
        "weights7a = np.array([W7a[i, i+1] for i in range(N7-1)])\n",
        "axes[0].plot(t7[:-1], weights7a, 'k-', linewidth=0.8)\n",
        "axes[0].set_title('Adaptive Edge Weights')\n",
