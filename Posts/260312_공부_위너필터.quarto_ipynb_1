      "cell_type": "code",
      "metadata": {},
      "source": [
        "from scipy.spatial.distance import pdist, squareform\n",
        "\n",
        "np.random.seed(2026)\n",
        "N5 = 100\n",
        "\n",
        "# Random 2D points\n",
        "pos5 = np.random.rand(N5, 2)\n",
        "\n",
        "# k-NN graph (symmetrized) with Gaussian weights\n",
        "k5 = 7\n",
        "dist_mat = squareform(pdist(pos5))\n",
        "h5 = np.median(dist_mat[dist_mat > 0]) / 3  # bandwidth\n",
        "\n",
        "W5 = np.zeros((N5, N5))\n",
        "for i in range(N5):\n",
        "    knn = np.argsort(dist_mat[i])[1:k5+1]\n",
        "    for j in knn:\n",
        "        w = np.exp(-dist_mat[i, j]**2 / (2 * h5**2))\n",
        "        W5[i, j] = w\n",
        "        W5[j, i] = w  # symmetrize\n",
        "\n",
        "D5 = np.diag(W5.sum(axis=1))\n",
        "L5 = D5 - W5\n",
        "eigvals5, V5 = np.linalg.eigh(L5)\n",
        "\n",
        "# Edge list for drawing\n",
        "edges5 = list(zip(*np.nonzero(np.triu(W5 > 0))))\n",
        "\n",
        "# Clean signal: smooth spatial function\n",
        "x_clean5 = np.sin(2 * np.pi * pos5[:, 0]) * np.cos(np.pi * pos5[:, 1])\n",
        "\n",
        "# Noisy signal\n",
        "sigma_n5 = 0.2\n",
        "y5 = x_clean5 + sigma_n5 * np.random.randn(N5)\n",
        "\n",
        "print(f'Nodes: {N5}, Edges: {len(edges5)}, k={k5}')\n",
        "print(f'Bandwidth h = {h5:.4f}')"
